# .env の雛形です。値はすべてダミーです。本物の値はコミットしないでください。
# NOTE: .env は --execute を付けて実行したときだけ読み込まれます。

MYSQL_HOST='db.example.invalid'
MYSQL_PORT='3306'
MYSQL_USER='shuumulator'
MYSQL_PASSWORD='change-me'
MYSQL_DATABASE='shuumulator'

# TLS は既定で有効です。有効なときは MYSQL_SSL_CA が必須で、証明書とホスト名を検証します。
# 検証できなければ接続しません。
MYSQL_TLS='true'
MYSQL_SSL_CA='/path/to/ca.pem'
MYSQL_SSL_VERIFY_IDENTITY='true'

# 売買を記録するユーザ (trading.user_id) です。
SHUUMULATOR_USER_ID='1'
